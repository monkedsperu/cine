# Contraseña del administrador (puede crear y eliminar contraseñas de usuario desde el panel)
ADMIN_PASSWORD=cambia-esto

# Contraseñas de usuario, separadas por comas (no pueden contener comas)
APP_PASSWORDS=usuario1,usuario2

# Sitio del cine (obligatorio) y CDN de los pósters (opcional: sin él no se muestran pósters)
URL_CINE=https://www.sitio-del-cine.com
URL_CINE_CDN=https://cdn.sitio-del-cine.com

# Puerto donde escucha el bot (por defecto 5100)
# PORT=5100

# Interfaz de red. En el servidor, detrás de nginx, usa 127.0.0.1 para que el 5100
# no sea accesible desde internet (solo por nginx en el 4100).
# HOST=127.0.0.1

# Pon 1 si corre detrás de nginx u otro proxy, para limitar los intentos de login por la IP real
# TRUST_PROXY=1
